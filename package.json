{
  "name": "between-the-words",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "remotion studio",
    "cues": "tsx scripts/build-cues.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "banned": "bash scripts/check-banned.sh",
    "check": "npm run typecheck && npm run lint && npm run test && npm run banned",
    "transitions": "tsx scripts/verify-transitions.ts",
    "qa": "tsx scripts/full-qa.ts",
    "still": "remotion still src/index.ts Video",
    "render": "remotion render src/index.ts Video out/between-the-words.mp4 --codec=h264 --crf=16"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/layout-utils": "4.0.538",
    "@remotion/media-utils": "4.0.538",
    "@remotion/noise": "4.0.538",
    "@remotion/paths": "4.0.538",
    "lucide-react": "^1.61.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@eslint/js": "9.20.0",
    "@types/node": "22.13.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.20.1",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.0.5"
  }
}
